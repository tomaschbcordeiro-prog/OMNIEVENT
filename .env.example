# Public base URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Data providers -------------------------------------------------------
# Ticketmaster Discovery API — free key at https://developer.ticketmaster.com
# When set, real events load automatically and demo data switches off (see DEMO_MODE).
TICKETMASTER_API_KEY=
# Optional: comma-separated ISO country codes to sync (default: 22 Ticketmaster markets)
TICKETMASTER_COUNTRIES=
# The whole catalogue is read in date windows up to TICKETMASTER_DAYS_AHEAD (default 730).
# TICKETMASTER_MAX_CALLS caps real API requests per run (default 1200; quota is 5,000/day).
# TICKETMASTER_CACHE_HOURS=72   # how long answers are reused before being asked again
# A run every TICKETMASTER_RUN_EVERY_MINUTES (default 30) reads for ~4 minutes and continues
# where the previous one stopped; a finished catalogue is read again after 12 hours.
TICKETMASTER_DAYS_AHEAD=730
TICKETMASTER_MAX_CALLS=1200

# SeatGeek Platform API — free client id at https://seatgeek.com/account/develop (US/Canada)
SEATGEEK_CLIENT_ID=
# SEATGEEK_CLIENT_SECRET=      # optional
# SEATGEEK_COUNTRIES=US,CA
# SEATGEEK_MAX_CALLS=600     # requests per run; the whole US/Canada catalogue is read in date windows

# Skiddle Events API — free key at https://www.skiddle.com/api/join.php (UK/Ireland)
SKIDDLE_API_KEY=
# SKIDDLE_COUNTRIES=GB,IE

# football-data.org — free key at https://www.football-data.org/client/register
# Live updates for every scheduled match of the 12 free competitions (a snapshot is shown without it).
FOOTBALL_DATA_KEY=
# FOOTBALL_COMPETITIONS=PL,ELC,PD,BL1,SA,FL1,DED,PPL,BSA,CL,WC,EC

# City of Lisbon, Paris and Madrid open data, and Lisbon venue calendars (CCB, Chapitô),
# need no key and are on by default.
# Switch any source off with a comma-separated list of ids:
# DISABLED_PROVIDERS=paris,madrid,lisbon

# Max events imported per provider sync run (quota protection)
SYNC_MAX_EVENTS=25000
# Longest a cold page load waits for sources before rendering what has arrived (ms)
FIRST_LOAD_WAIT_MS=12000

# Demo data: auto (default: on only when no real provider is configured) | on | off
DEMO_MODE=auto

# --- Map imagery, terrain and place search (optional) ----------------------
# Without a key the map uses free sources: Sentinel-2 cloudless imagery (≈10 m, sharp to
# city scale), OpenFreeMap streets/buildings, AWS terrain tiles and Photon place search.
# A free MapTiler key (https://cloud.maptiler.com, 100k requests/month on the free plan)
# switches to MapTiler Satellite (street-level detail where available), MapTiler terrain
# and MapTiler geocoding. The public key is visible in the browser by design: restrict it
# to your domain in the MapTiler dashboard.
NEXT_PUBLIC_MAPTILER_KEY=
# Optional separate server-side key for MapTiler geocoding. Create a second key WITHOUT
# allowed-origin restrictions (it stays on the server). Without it, search uses Photon.
MAPTILER_KEY=

# --- Scheduled sync ---------------------------------------------------------
# Secret for /api/sync (Vercel Cron sends it as a Bearer token automatically)
CRON_SECRET=

# --- Community (ratings, posts, plans) ---------------------------------------
# Shared storage for the community. In Vercel: Storage → Create → Upstash for Redis
# (free plan) → connect to this project; it sets these two automatically. Without them
# posts live only in one server's memory and disappear on restart.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Database & auth (not yet wired; see db/README.md) ---------------------
# DATABASE_URL=postgres://…
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server-only, never exposed to the browser
