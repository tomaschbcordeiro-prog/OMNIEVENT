# Public base URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Data providers -------------------------------------------------------
# Ticketmaster Discovery API — free key at https://developer.ticketmaster.com
# When set, real events load automatically and demo data switches off (see DEMO_MODE).
TICKETMASTER_API_KEY=
# Optional: comma-separated ISO country codes to sync (default: 22 Ticketmaster markets)
TICKETMASTER_COUNTRIES=
# Optional: refresh interval in minutes (default 60)
TICKETMASTER_REFRESH_MINUTES=60

# Max events imported per provider sync run (quota protection)
SYNC_MAX_EVENTS=5000

# Demo data: auto (default: on only when no real provider is configured) | on | off
DEMO_MODE=auto

# --- Map imagery, terrain and place search (optional) ----------------------
# Without a key the map uses free sources: Sentinel-2 cloudless imagery (≈10 m, sharp to
# city scale), OpenFreeMap streets/buildings, AWS terrain tiles and Photon place search.
# A free MapTiler key (https://cloud.maptiler.com, 100k requests/month on the free plan)
# switches to MapTiler Satellite (street-level detail where available), MapTiler terrain
# and MapTiler geocoding. The public key is visible in the browser by design: restrict it
# to your domain in the MapTiler dashboard.
NEXT_PUBLIC_MAPTILER_KEY=
# Optional separate server-side key for geocoding (falls back to the public key)
MAPTILER_KEY=

# --- Scheduled sync ---------------------------------------------------------
# Secret for /api/sync (Vercel Cron sends it as a Bearer token automatically)
CRON_SECRET=

# --- Database & auth (not yet wired; see db/README.md) ---------------------
# DATABASE_URL=postgres://…
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server-only, never exposed to the browser
